# Copy to .env.aws and replace the placeholder values before deployment.
# Generate strong values, for example with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET_KEY=replace-with-a-different-long-random-secret

# Optional: leave blank to use extractive answers without OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional Supabase browser configuration for the Node chat UI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
