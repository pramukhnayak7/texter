# Copy to .env and fill in your values

# PostgreSQL (local dev)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb

# Session secret (change this in production!)
SESSION_SECRET_KEY=dev-secret-change-in-production

# Default admin user (created automatically on first init)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# OpenRouter (get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/free

# Existing Node chat frontend (optional for the RAG backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
PORT=3000

# Without an OpenRouter key, the app returns the best matching document passage.
