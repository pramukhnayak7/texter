{
  "manifest_version": 3,
  "name": "AI Teacher Integration",
  "version": "1.0",
  "description": "Floating AI assistant for analyzing selected text on any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle AI Mode"
  }
}
